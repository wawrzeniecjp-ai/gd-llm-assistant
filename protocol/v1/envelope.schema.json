{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://geode-llm.local/protocol/v1/envelope.schema.json",
    "title": "Protocol v1 message envelope",
    "description": "Single validation entry point for the mod/sidecar protocol (SPEC.md 7.3). Resolve $defs.registry by a frame's `type` to find the schema for its payload, and the expected direction.",

    "$defs": {
        "registry": {
            "type": "object",
            "description": "type -> { direction, payload, result? }. `result` is present for requests and absent for events.",
            "additionalProperties": false,
            "properties": {
                "hello": {
                    "type": "object",
                    "properties": {
                        "direction": { "const": "m2s" },
                        "payload": { "const": "hello.schema.json#/$defs/helloRequest" },
                        "result": { "const": "hello.schema.json#/$defs/helloResult" }
                    },
                    "required": ["direction", "payload", "result"],
                    "additionalProperties": false
                },
                "response": {
                    "type": "object",
                    "description": "Correlated reply to a request. Result shape is determined by the request kind.",
                    "properties": {
                        "direction": { "const": "both" },
                        "payload": { "const": "common.schema.json#/$defs/ResponsePayload" }
                    },
                    "required": ["direction", "payload"],
                    "additionalProperties": false
                },
                "user_message": {
                    "type": "object",
                    "properties": {
                        "direction": { "const": "m2s" },
                        "payload": { "const": "chat.schema.json#/$defs/userMessage" }
                    },
                    "required": ["direction", "payload"],
                    "additionalProperties": false
                },
                "cancel_turn": {
                    "type": "object",
                    "properties": {
                        "direction": { "const": "m2s" },
                        "payload": { "const": "chat.schema.json#/$defs/cancelTurn" }
                    },
                    "required": ["direction", "payload"],
                    "additionalProperties": false
                },
                "tool_call": {
                    "type": "object",
                    "properties": {
                        "direction": { "const": "s2m" },
                        "payload": { "const": "chat.schema.json#/$defs/toolCall" }
