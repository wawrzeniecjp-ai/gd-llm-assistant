                    "required": ["direction", "payload"],
                    "additionalProperties": false
                },
                "transaction_reverted": {
                    "type": "object",
                    "properties": {
                        "direction": { "const": "m2s" },
                        "payload": { "const": "chat.schema.json#/$defs/transactionReverted" }
                    },
                    "required": ["direction", "payload"],
                    "additionalProperties": false
                },
                "turn_started": {
