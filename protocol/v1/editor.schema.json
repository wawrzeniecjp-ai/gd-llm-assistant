{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://geode-llm.local/protocol/v1/editor.schema.json",
    "title": "Editor requests and events",
    "description": "SPEC.md 7.5 (requests, sidecar -> mod) and 7.6 (events, mod -> sidecar). Each `*Payload` is a request; the matching `*Result` is the `result` of the response. Each `*Event` is an event payload.",

    "$defs": {
        "Bounds": {
            "type": "object",
            "properties": {
                "x1": { "type": "number" },
                "y1": { "type": "number" },
                "x2": { "type": "number" },
                "y2": { "type": "number" }
            },
            "required": ["x1", "y1", "x2", "y2"],
            "additionalProperties": false
        },

        "TypeCount": {
            "type": "object",
            "required": ["id", "count"],
            "properties": {
                "id": { "$ref": "common.schema.json#/$defs/ObjectTypeId" },
                "count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
        },

        "TxnSummary": {
            "type": "object",
            "required": ["created", "modified", "deleted"],
            "properties": {
                "created": { "type": "integer", "minimum": 0 },
                "modified": { "type": "integer", "minimum": 0 },
                "deleted": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
        },

        "Camera": {
            "type": "object",
            "description": "Where the editor is looking. x and y are level coordinates of the centre of the view, not screen coordinates.",
            "required": ["x", "y", "zoom", "visible"],
            "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "zoom": { "type": "number", "exclusiveMinimum": 0 },
                "visible": {
                    "$ref": "#/$defs/Bounds",
                    "description": "The rectangle of the level on screen, in level coordinates. The same space objects use, so it can be compared with query results directly."
                }
            },
            "additionalProperties": false
        },

        "MissingIds": {
            "type": "array",
            "description": "Unique IDs that no longer resolve. Reported, not fatal, unless none were found (then OBJECT_NOT_FOUND).",
            "maxItems": 5000,
            "items": { "$ref": "common.schema.json#/$defs/UniqueId" }
        },

        "getEditorStatePayload": {
            "x-direction": "s2m",
            "type": "object",
            "maxProperties": 0,
            "additionalProperties": false
        },
        "getEditorStateResult": {
            "type": "object",
            "required": ["object_count", "grid_size", "playtesting"],
            "properties": {
                "object_count": { "type": "integer", "minimum": 0 },
                "selected": {
                    "type": "object",
                    "properties": {
                        "count": { "type": "integer", "minimum": 0 },
                        "by_type": { "type": "array", "items": { "$ref": "#/$defs/TypeCount" }, "maxItems": 20 },
                        "bounds": { "$ref": "#/$defs/Bounds" }
                    },
                    "additionalProperties": false
                },
                "editor_layer": { "type": "integer", "minimum": 0 },
                "camera": {
                    "$ref": "#/$defs/Camera",
                    "description": "Where the view is looking. Omitted when the editor could not report it, rather than filled with zeros: a camera at (0, 0) zoom 1 is a plausible-looking lie."
                },
                "ground_y": { "type": "number", "description": "Ground height; required for sensible placements." },
                "grid_size": { "const": 30, "description": "GD units per grid block." },
                "playtesting": { "type": "boolean" },
                "level": {
                    "type": "object",
                    "properties": { "name": { "type": "string", "maxLength": 256 } },
                    "additionalProperties": false
                },
                "revision": { "$ref": "#/$defs/Revision" }
            },
            "additionalProperties": false
        },

        "Revision": {
            "type": "integer",
            "minimum": 0,
            "description": "LEVEL-DESIGN-SPEC.md 4.3.2. Increases whenever the mod observes the level's objects change, from any source. Only equality is meaningful: two reads with the same revision saw the same objects."
        },

        "QueryFilters": {
            "type": "object",
            "description": "SPEC.md 7.5. All filters are optional; omitted filters do not constrain.",
            "properties": {
                "id": { "$ref": "common.schema.json#/$defs/ObjectTypeId" },
                "ids": {
                    "type": "array",
                    "maxItems": 500,
                    "items": { "$ref": "common.schema.json#/$defs/UniqueId" }
                },
                "editor_layer": { "type": "integer", "minimum": 0 },
                "z_layer": { "$ref": "common.schema.json#/$defs/ZLayer" },
                "group": { "type": "integer", "minimum": 1, "maximum": 9999 },
                "x_range": { "$ref": "common.schema.json#/$defs/Range" },
                "y_range": { "$ref": "common.schema.json#/$defs/Range" },
                "selected_only": { "type": "boolean" }
            },
            "additionalProperties": false
        },

        "queryObjectsPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["filters"],
            "properties": {
                "filters": { "$ref": "#/$defs/QueryFilters" },
                "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
                "cursor": { "type": ["string", "null"], "maxLength": 128 }
            },
            "additionalProperties": false
        },
        "queryObjectsResult": {
            "type": "object",
            "required": ["objects", "total_matches", "truncated"],
            "properties": {
                "objects": {
                    "type": "array",
                    "maxItems": 500,
                    "items": { "$ref": "common.schema.json#/$defs/ObjectRecord" }
                },
                "total_matches": { "type": "integer", "minimum": 0 },
                "next_cursor": { "type": ["string", "null"], "maxLength": 128 },
                "truncated": { "type": "boolean" }
            },
            "additionalProperties": false
        },

        "summarizeRegionPayload": {
            "x-direction": "s2m",
            "type": "object",
            "description": "Preferred over bulk query_objects for understanding a region.",
            "properties": {
                "x_range": { "$ref": "common.schema.json#/$defs/Range" },
                "y_range": { "$ref": "common.schema.json#/$defs/Range" },
                "editor_layer": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
        },
        "summarizeRegionResult": {
            "type": "object",
            "required": ["total", "by_type"],
            "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "bounds": { "$ref": "#/$defs/Bounds" },
                "by_type": {
                    "type": "array",
                    "description": "Capped at 20 entries.",
                    "maxItems": 20,
                    "items": { "$ref": "#/$defs/TypeCount" }
                }
            },
            "additionalProperties": false
        },

        "getObjectPropertiesPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["object_id"],
            "properties": {
                "object_id": { "$ref": "common.schema.json#/$defs/UniqueId" }
            },
            "additionalProperties": false
        },
        "getObjectPropertiesResult": {
            "type": "object",
            "required": ["properties"],
            "properties": {
                "properties": { "$ref": "common.schema.json#/$defs/PropertySet" }
            },
            "additionalProperties": false
        },

        "createObjectsPayload": {
            "x-direction": "s2m",
            "type": "object",
            "description": "Validated whole before any mutation, so a request is rejected rather than half-applied.",
            "required": ["objects"],
            "properties": {
                "objects": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5000,
                    "items": {
                        "type": "object",
                        "required": ["id", "x", "y"],
                        "properties": {
                            "id": { "$ref": "common.schema.json#/$defs/ObjectTypeId" },
                            "x": { "type": "number" },
                            "y": { "type": "number" },
                            "properties": { "$ref": "common.schema.json#/$defs/PropertySet" }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "createObjectsResult": {
            "type": "object",
            "required": ["created", "count"],
            "properties": {
                "created": {
                    "type": "array",
                    "maxItems": 5000,
                    "items": { "$ref": "common.schema.json#/$defs/UniqueId" }
                },
                "count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
        },

        "modifyObjectsPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["targets"],
            "properties": {
                "targets": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5000,
                    "items": { "$ref": "common.schema.json#/$defs/UniqueId" }
                },
                "set": { "$ref": "common.schema.json#/$defs/PropertySet" },
                "delta": { "$ref": "common.schema.json#/$defs/PropertyDelta" }
            },
            "additionalProperties": false,
            "anyOf": [{ "required": ["set"] }, { "required": ["delta"] }]
        },
        "modifyObjectsResult": {
            "type": "object",
            "required": ["modified_count", "missing"],
            "properties": {
                "modified_count": { "type": "integer", "minimum": 0 },
                "missing": { "$ref": "#/$defs/MissingIds" }
            },
            "additionalProperties": false
        },

        "deleteObjectsPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["targets"],
            "properties": {
                "targets": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5000,
                    "items": { "$ref": "common.schema.json#/$defs/UniqueId" }
                }
            },
            "additionalProperties": false
        },
        "deleteObjectsResult": {
            "type": "object",
            "required": ["deleted_count", "missing"],
            "properties": {
                "deleted_count": { "type": "integer", "minimum": 0 },
                "missing": { "$ref": "#/$defs/MissingIds" }
            },
            "additionalProperties": false
        },

        "setSelectionPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["targets"],
            "properties": {
                "targets": {
                    "type": "array",
                    "maxItems": 5000,
                    "items": { "$ref": "common.schema.json#/$defs/UniqueId" }
                }
            },
            "additionalProperties": false
        },
        "setSelectionResult": {
            "type": "object",
            "required": ["selected_count"],
            "properties": { "selected_count": { "type": "integer", "minimum": 0 } },
            "additionalProperties": false
        },

        "beginTransactionPayload": {
            "x-direction": "s2m",
            "type": "object",
            "properties": { "label": { "type": "string", "maxLength": 128 } },
            "additionalProperties": false
        },
        "beginTransactionResult": {
            "type": "object",
            "required": ["txn_id"],
            "properties": { "txn_id": { "type": "string", "maxLength": 64 } },
            "additionalProperties": false
        },

        "endTransactionPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["txn_id"],
            "properties": { "txn_id": { "type": "string", "maxLength": 64 } },
            "additionalProperties": false
        },
        "endTransactionResult": {
            "type": "object",
            "required": ["txn_id", "summary"],
            "properties": {
                "txn_id": { "type": "string", "maxLength": 64 },
                "summary": { "$ref": "#/$defs/TxnSummary" }
            },
            "additionalProperties": false
        },

        "revertTransactionPayload": {
            "x-direction": "s2m",
            "type": "object",
            "description": "Usually triggered from the panel's Revert action rather than the sidecar (D3). Succeeds only while the transaction is the most recent change.",
            "required": ["txn_id"],
            "properties": { "txn_id": { "type": "string", "maxLength": 64 } },
            "additionalProperties": false
        },
        "revertTransactionResult": {
            "type": "object",
            "required": ["reverted"],
            "properties": { "reverted": { "const": true } },
            "additionalProperties": false
        },

        "listObjectCatalogPayload": {            "x-direction": "s2m",
            "type": "object",
            "description": "One page of the game's id -> sprite table. Paged because the table holds a few thousand ids.",
            "properties": {
                "offset": { "type": "integer", "minimum": 0 },
                "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }
            },
            "additionalProperties": false
        },
        "listObjectCatalogResult": {
            "x-direction": "m2s",
            "type": "object",
            "description": "The game's own object table, read from ObjectToolbox rather than authored by hand. `next_offset` is null on the last page.",
            "required": ["entries", "total", "next_offset"],
            "properties": {
                "entries": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/ObjectCatalogEntry" }
                },
                "total": { "type": "integer", "minimum": 0 },
                "next_offset": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "description": "Offset to request next, or null when this is the last page."
                }
            },
            "additionalProperties": false
        },
        "ObjectCatalogEntry": {
            "type": "object",
            "required": ["id"],
            "properties": {
                "id": { "type": "integer" },
                "frame": {
                    "type": "string",
                    "description": "Sprite frame the game draws, e.g. spike_02_001.png. Absent when the type is drawn programmatically."
                },
                "grid_size": {
                    "type": "number",
                    "description": "Grid footprint in GD units, from ObjectToolbox::gridNodeSizeForKey. Absent when the game reports none."
                }
            },
            "additionalProperties": false
        },

        "describeObjectTypesPayload": {
            "x-direction": "s2m",
            "type": "object",
            "description": "LEVEL-DESIGN-SPEC.md 4.2. One page of the game's object types, each instantiated off-scene and described. Same paging as list_object_catalog.",
            "properties": {
                "offset": { "type": "integer", "minimum": 0 },
                "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
                "ids": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "maxItems": 500,
                    "description": "Describe exactly these ids instead of a page of the table."
                }
            },
            "additionalProperties": false
        },
        "describeObjectTypesResult": {
            "x-direction": "m2s",
            "type": "object",
            "required": ["entries", "total", "next_offset", "failed"],
            "properties": {
                "entries": { "type": "array", "items": { "$ref": "#/$defs/ObjectTypeDescription" } },
                "total": { "type": "integer", "minimum": 0 },
                "next_offset": { "type": ["integer", "null"], "minimum": 0 },
                "failed": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "description": "Ids the game would not instantiate (createWithKey returned null) or that are on the mod's creation denylist."
                }
            },
            "additionalProperties": false
        },
        "ObjectTypeDescription": {
            "type": "object",
            "description": "Read from an instance that was never added to the editor. `hitbox` is getObjectRect() relative to the object's centre at scale 1, rotation 0.",
            "required": ["id", "object_type", "hitbox", "radius", "is_trigger", "is_decoration", "has_detail_color", "default_z_layer"],
            "properties": {
                "id": { "type": "integer" },
                "object_type": { "type": "integer", "description": "GameObjectType, as the game's integer." },
                "hitbox": {
                    "type": "object",
                    "required": ["x", "y", "w", "h"],
                    "properties": {
                        "x": { "type": "number", "description": "Left edge, relative to the centre." },
                        "y": { "type": "number", "description": "Bottom edge, relative to the centre." },
                        "w": { "type": "number", "minimum": 0 },
                        "h": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": false
                },
                "radius": { "type": "number", "minimum": 0, "description": "m_objectRadius; non-zero for circular hitboxes." },
                "visual": {
                    "type": "object",
                    "required": ["w", "h"],
                    "properties": {
                        "w": { "type": "number", "minimum": 0 },
                        "h": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": false
                },
                "is_trigger": { "type": "boolean" },
                "is_decoration": { "type": "boolean" },
                "has_detail_color": { "type": "boolean" },
                "default_z_layer": { "type": "integer" }
            },
            "additionalProperties": false
        },

        "getLevelObjectsPayload": {
            "x-direction": "s2m",
            "type": "object",
            "description": "LEVEL-DESIGN-SPEC.md 4.3.2. Every object as its save string, paged. The cursor is only valid while `revision` is unchanged.",
            "properties": {
                "cursor": { "type": ["string", "null"], "maxLength": 32 },
                "limit": { "type": "integer", "minimum": 1, "maximum": 2000 }
            },
            "additionalProperties": false
        },
        "getLevelObjectsResult": {
            "x-direction": "m2s",
            "type": "object",
            "required": ["objects", "total", "revision", "next_cursor"],
            "properties": {
                "objects": { "type": "array", "items": { "$ref": "#/$defs/LevelObjectRecord" } },
                "total": { "type": "integer", "minimum": 0 },
                "revision": { "$ref": "#/$defs/Revision" },
                "next_cursor": { "type": ["string", "null"], "maxLength": 32 }
            },
            "additionalProperties": false
        },
        "LevelObjectRecord": {
            "type": "object",
            "description": "`properties` is read exactly as get_object_properties reads it -- protocol coordinates included -- so callers never decode position, rotation, scale or flip from the save string. `save` carries everything else.",
            "required": ["object_id", "id", "properties", "save"],
            "properties": {
                "object_id": { "$ref": "common.schema.json#/$defs/UniqueId" },
                "id": { "$ref": "common.schema.json#/$defs/ObjectTypeId" },
                "properties": { "$ref": "common.schema.json#/$defs/PropertySet" },
                "save": { "type": "string", "maxLength": 65536 }
            },
            "additionalProperties": false
        },

        "captureScreenshotPayload": {
            "x-direction": "s2m",
            "type": "object",
            "properties": {
                "region": {
                    "type": "string",
                    "enum": ["screen", "selection"],
                    "description": "'screen' for the whole editor view, 'selection' for a padded box around the selected objects."
                },
                "radius": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2000,
                    "description": "Padding around the selection, in points. Ignored for 'screen'."
                },
                "include_ui": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show the editor's chrome (toolbars, buttons, grid controls) in the capture. Off by default: the first live test had the model describing toolbars instead of the level, and the chat panel is always hidden either way."
                }
            },
            "additionalProperties": false
        },
        "captureScreenshotResult": {
            "x-direction": "m2s",
            "type": "object",
            "description": "A written PNG. The path is returned rather than the bytes: a frame limit of 1 MB, no base64 encoder in the mod, and both processes on the same machine make a file the natural medium.",
            "required": ["path", "width", "height", "targets"],
            "properties": {
                "path": { "type": "string", "maxLength": 512 },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 },
                "targets": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Objects the region was computed from; 0 for a whole-screen capture."
                },
                "region": {
                    "type": "object",
                    "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" },
                        "width": { "type": "number" },
                        "height": { "type": "number" }
                    },
                    "additionalProperties": false
                },
                "viewport": {
                    "$ref": "#/$defs/Bounds",
                    "description": "The same area in level coordinates -- what the image actually covers, so it can be compared against object positions. `region` is the crop in screen points and is not usable for that."
                }
            },
            "additionalProperties": false
        },
        "getCameraPayload": {
            "x-direction": "s2m",
            "type": "object",
            "maxProperties": 0,
            "additionalProperties": false
        },
        "setCameraPayload": {
            "x-direction": "s2m",
            "type": "object",
            "description": "Where the editor view should look. Every field is optional; the ones given are applied together. This moves the user's screen, not the level.",
            "minProperties": 1,
            "properties": {
                "x": {
                    "type": "number",
                    "minimum": -200000,
                    "maximum": 200000,
                    "description": "Level x of the point to centre on."
                },
                "y": {
                    "type": "number",
                    "minimum": -200000,
                    "maximum": 200000,
                    "description": "Level y of the point to centre on. The ground is around 0 and most building happens between -30 and 300."
                },
                "zoom": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Magnification; 1 is the default view. Clamped to 0.05..4 rather than refused - zoom is a view setting with an obvious 'as far as it goes' reading."
                }
            },
            "additionalProperties": false
        },
        "cameraResult": {
            "x-direction": "m2s",
            "type": "object",
            "description": "The view as it stands after the operation, measured rather than echoed, so a clamped zoom or a pan stopped by the level edge shows up here.",
            "required": ["camera"],
            "properties": {
                "camera": { "$ref": "#/$defs/Camera" }
            },
            "additionalProperties": false
        },
        "getLevelSettingsPayload": {
            "x-direction": "s2m",
            "type": "object",
            "maxProperties": 0,
            "additionalProperties": false
        },
        "setLevelSettingsPayload": {
            "x-direction": "s2m",
            "type": "object",
            "description": "Level-wide settings. Every field is optional; the ones given are applied together, and unknown keys are refused rather than ignored.",
            "minProperties": 1,
            "properties": {
                "background": { "type": "integer", "minimum": 0, "maximum": 100 },
                "ground": { "type": "integer", "minimum": 0, "maximum": 100 },
                "ground_line": { "type": "integer", "minimum": 0, "maximum": 50 },
                "middle_ground": { "type": "integer", "minimum": 0, "maximum": 100 },
                "start_mode": { "type": "integer", "minimum": 0, "maximum": 12 },
                "start_mini": { "type": "boolean" },
                "start_dual": { "type": "boolean" },
                "two_player": { "type": "boolean" },
                "platformer": { "type": "boolean" },
                "reverse": { "type": "boolean" },
                "rotate_gameplay": { "type": "boolean" },
                "mirror": { "type": "boolean" },
                "song_offset": { "type": "number" },
                "audio_track": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Index into the normal song catalogue. Refused when the level uses a custom catalogue."
                }
            },
            "additionalProperties": false
        },
        "levelSettingsResult": {
            "x-direction": "m2s",
            "type": "object",
            "description": "The settings as they stand after the operation.",
            "required": ["settings"],
            "properties": {
                "settings": { "$ref": "#/$defs/LevelSettings" },
                "revertible": {
                    "type": "boolean",
                    "description": "False for a write: settings are level state, not object edits, so a turn Revert does not undo them."
                }
            },
            "additionalProperties": false
        },
        "LevelSettings": {
            "type": "object",
            "properties": {
                "background": { "type": "integer" },
                "ground": { "type": "integer" },
                "ground_line": { "type": "integer" },
                "middle_ground": { "type": "integer" },
                "start_mode": { "type": "integer" },
                "start_mini": { "type": "boolean" },
                "start_dual": { "type": "boolean" },
                "two_player": { "type": "boolean" },
                "platformer": { "type": "boolean" },
                "reverse": { "type": "boolean" },
                "rotate_gameplay": { "type": "boolean" },
                "mirror": { "type": "boolean" },
                "song_offset": { "type": "number" }
            },
            "additionalProperties": false
        },
        "getSavePropertiesPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["object_id"],
            "properties": { "object_id": { "$ref": "common.schema.json#/$defs/UniqueId" } },
            "additionalProperties": false
        },
        "savePropertiesResult": {
            "x-direction": "m2s",
            "type": "object",
            "description": "One object's raw save-string properties. Values are the exact text the save string stores; the sidecar names them from its generated table.",
            "required": ["object_id", "properties", "count"],
            "properties": {
                "object_id": { "$ref": "common.schema.json#/$defs/UniqueId" },
                "properties": {
                    "type": "array",
                    "maxItems": 512,
                    "items": {
                        "type": "object",
                        "required": ["key"],
                        "properties": {
                            "key": { "type": "integer", "minimum": 0 },
                            "value": { "type": "string" },
                            "name": {
                                "type": "string",
                                "description": "Filled in by the sidecar from the generated property table when the key is known."
                            },
                            "type": { "type": "string" }
                        },
                        "additionalProperties": false
                    }
                },
                "count": { "type": "integer", "minimum": 0 },
                "save_string": { "type": "string" }
            },
            "additionalProperties": false
        },
        "setSavePropertyPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["targets", "key", "value"],
            "properties": {
                "targets": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": { "$ref": "common.schema.json#/$defs/UniqueId" }
                },
                "key": {
                    "type": "integer",
                    "minimum": 4,
                    "description": "Save-string key to write. Keys 1-3 are the type and position and are refused; use id/x/y instead."
                },
                "value": {
                    "type": ["string", "number", "boolean"],
                    "description": "The exact text the save string should carry. Send strings for list and HSV encodings."
                }
            },
            "additionalProperties": false
        },
        "setSavePropertyResult": {
            "x-direction": "m2s",
            "type": "object",
            "description": "Setting a save key rebuilds the object, so IDs change. `replacements` gives the new ids.",
            "required": ["modified_count", "unchanged_count", "replacements", "failed", "ids_changed"],
            "properties": {
                "modified_count": { "type": "integer", "minimum": 0 },
                "unchanged_count": { "type": "integer", "minimum": 0 },
                "replacements": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["old_id", "new_id"],
                        "properties": {
                            "old_id": { "$ref": "common.schema.json#/$defs/UniqueId" },
                            "new_id": { "$ref": "common.schema.json#/$defs/UniqueId" }
                        },
                        "additionalProperties": false
                    }
                },
                "failed": {
                    "type": "array",
                    "items": { "$ref": "common.schema.json#/$defs/UniqueId" }
                },
                "ids_changed": { "const": true }
            },
            "additionalProperties": false
        },
        "getColorChannelPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["channel"],
            "properties": { "channel": { "type": "integer", "minimum": 1 } },
            "additionalProperties": false
        },
        "setColorChannelPayload": {
            "x-direction": "s2m",
            "type": "object",
            "required": ["channel", "red", "green", "blue"],
            "properties": {
                "channel": { "type": "integer", "minimum": 1 },
                "red": { "type": "integer", "minimum": 0, "maximum": 255 },
                "green": { "type": "integer", "minimum": 0, "maximum": 255 },
                "blue": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "additionalProperties": false
        },
        "colorChannelResult": {
            "x-direction": "m2s",
            "type": "object",
            "description": "A colour channel on the level's colour page. `exists` is false when nothing in the level uses the id.",
            "required": ["channel", "exists", "red", "green", "blue"],
            "properties": {
                "channel": { "type": "integer" },
                "exists": { "type": "boolean" },
                "red": { "type": "integer", "minimum": 0, "maximum": 255 },
                "green": { "type": "integer", "minimum": 0, "maximum": 255 },
                "blue": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "additionalProperties": false
        },

        "pingPayload": {
            "x-direction": "s2m",
            "type": "object",
            "maxProperties": 0,
            "additionalProperties": false
        },
        "pingResult": {
            "type": "object",
            "required": ["pong"],
            "properties": { "pong": { "const": true } },
            "additionalProperties": false
        },

        "editorClosedEvent": {
            "x-direction": "m2s",
            "type": "object",
            "description": "Sent when the editor closes; the mod then closes the socket with code 1000.",
            "maxProperties": 0,
            "additionalProperties": false
        },

        "levelChangedEvent": {
            "x-direction": "m2s",
            "type": "object",
            "description": "Coalesced: at most one flush per 250 ms. `source` prevents echo loops.",
            "required": ["added", "removed", "modified", "source"],
            "properties": {
                "added": { "type": "integer", "minimum": 0 },
                "removed": { "type": "integer", "minimum": 0 },
                "modified": { "type": "integer", "minimum": 0 },
                "bounds": { "$ref": "#/$defs/Bounds" },
                "source": { "type": "string", "enum": ["user", "assistant"] },
                "revision": { "$ref": "#/$defs/Revision" }
            },
            "additionalProperties": false
        },

        "selectionChangedEvent": {
            "x-direction": "m2s",
            "type": "object",
            "description": "Throttled to 250 ms; ids capped at 200.",
            "required": ["count", "ids", "truncated"],
            "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "ids": {
                    "type": "array",
                    "maxItems": 200,
                    "items": { "$ref": "common.schema.json#/$defs/UniqueId" }
                },
                "truncated": { "type": "boolean" }
            },
            "additionalProperties": false
        },

        "progressEvent": {
            "x-direction": "m2s",
            "type": "object",
            "description": "Emitted for long jobs only (spanning more than ~10 frames).",
            "required": ["request_id", "done", "total"],
            "properties": {
                "request_id": { "type": "string", "maxLength": 64 },
                "done": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
        },

        "errorEvent": {
            "x-direction": "m2s",
            "type": "object",
            "description": "Unsolicited error, not a response to a request.",
            "required": ["code", "message"],
            "properties": {
                "code": { "$ref": "common.schema.json#/$defs/ErrorCode" },
                "message": { "type": "string", "maxLength": 512 }
            },
            "additionalProperties": false
        }
    }
}
