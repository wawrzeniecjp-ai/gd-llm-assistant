# Copy to .env and fill in. Never commit .env (see ../.gitignore).
#
# The API key is read only by this process and is redacted from all logs and
# error strings (SPEC.md 12). It is never sent to the mod.

# --- LLM provider ------------------------------------------------------
# One of: anthropic, openai, openai_compatible, scripted
#
#   scripted  = no API key, no network, no cost. A deterministic fake that
#               makes real tool calls, so the whole mod can be tried before a
#               provider is configured. It places a small fixed demo edit
#               rather than answering your actual level.
llm_provider=
api_key=
# No default on purpose: forces an explicit, current model choice (SPEC.md 9.2).
# Not required when llm_provider=scripted.
model=

# Optional endpoint override for OpenAI-compatible providers (local runners etc.)
# base_url=
# Output tokens per model call, reasoning included. Too low and a thinking model is cut
# off before it acts; the panel then says the turn ran out of output space.
max_tokens=16384
temperature=0.2

# Delay the scripted provider waits before answering, in ms. Exists so the
# thinking indicator is visible and cancellation has somewhere to land.
# scripted_turn_delay_ms=600

# --- Transport ---------------------------------------------------------
ws_host=127.0.0.1
ws_port=18765
# Set true only if you really need a non-loopback bind.
# allow_non_loopback=false

# How long a request to the mod may take before it is treated as failed.
# request_timeout_s=30

# --- Tool loop limits (SPEC.md 6.2.3, 10.2) ----------------------------
max_tool_rounds=40
max_objects_per_turn=5000
# Caps total tokens per turn (runaway-cost guard). Empty = no cap.
turn_token_budget=
turn_timeout_s=300
history_token_budget=8000

# Retries for retryable provider failures (429 / 5xx). 0 disables.
# provider_max_retries=3
# provider_retry_base_s=1.0

# --- Object catalog ----------------------------------------------------
# Optional JSON list of extra object ids, merged over the built-in seed:
#   [{"id": 8, "name": "Spike", "category": "hazards", "aliases": ["hazard"]}]
# The built-in catalog is a deliberately tiny seed; adding verified ids here is
# how the assistant gains the ability to place more than the basics.
# catalog_path=./catalog.json

# --- Persistence / logging ---------------------------------------------
session_dir=./sessions
log_level=info
