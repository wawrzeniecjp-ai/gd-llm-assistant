    {
     "id": "call_00_8S9yIgvAYrDSpgQFA4I50827",
     "name": "place_grid",
     "arguments": {
      "grid": "@grid col=10 row=0 w=41 h=6\n.#######################################.\n..............#...............#......###.\n.....................................###.\n.........................................\nW.......................................C\n......^...............^..................",
